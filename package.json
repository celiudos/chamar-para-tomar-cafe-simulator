{
  "name": "chamar-para-tomar-cafe-simulator",
  "version": "0.3.0",
  "private": true,
  "description": "Simulador pixel-art de escritorio: o chefe percorre as baias e chama a equipe para tomar cafe.",
  "author": "Marcelo Note",
  "type": "module",
  "scripts": {
    "start": "live-server . --port=3000 --open=/ --watch=index.html,style.css,game,config,public/maps --ignore=node_modules --wait=200",
    "dev": "npm start",
    "build:map": "node scripts/build-baias-map.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "live-server": "1.2.2"
  }
}
